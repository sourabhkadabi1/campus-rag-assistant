# ── API Keys ──────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Database (direct Postgres via asyncpg) ────────────────
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Redis (Upstash URL or redis://localhost:6379) ─────────
REDIS_URL=

# ── Model chain for student answers (priority order) ─────
MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemma-4-26b,gemma-4-31b,groq:openai/gpt-oss-20b

# ── Summary generation ───────────────────────────────────
SUMMARY_MODEL=gemini-3.6-flash
SUMMARY_FALLBACK=gemini-3.8-flash
SUMMARY_RESERVE_RPD=10

# ── Embedding model (local sentence-transformers) ────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Upload settings ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── Chunking ─────────────────────────────────────────────
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# ── Query pipeline (Phase 2) ────────────────────────────
CACHE_TTL_HOURS=24
MAX_OUTPUT_TOKENS=800
MAX_OUTPUT_TOKENS_DETAILED=2000
RETRIEVAL_TOP_K=4
RETRIEVAL_TOP_K_DETAILED=6

# ── Router & limits (Phase 3) ────────────────────────────
PROVIDER_RESET_TIMEZONE=UTC
ROUTER_QUEUE_TIMEOUT_SECONDS=60
ROUTER_COOLDOWN_429_SECONDS=60
ROUTER_COOLDOWN_5XX_SECONDS=15
ROUTER_RPD_THRESHOLD_PCT=0.95

# ── Quotas & payments (Phase 4) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BUDGET_GUARD_THRESHOLD=0.90
MONTHLY_SPEND_CAP_USD=0
USER_RPM_LIMIT=5
PAID_PLAN_PRICE_PAISE=9900
PAID_PLAN_DURATION_DAYS=30
