# ── API Keys ──────────────────────────────────────────────
# Two separate Gemini projects: free-tier (no billing) and paid (billing enabled)
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
GROQ_API_KEY=

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Database (direct Postgres via asyncpg) ────────────────
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Redis (Upstash URL or redis://localhost:6379) ─────────
REDIS_URL=

# ── Model chains (comma-separated, priority order) ───────
# Free-tier chain: models called with GEMINI_API_KEY_FREE
MODEL_CHAIN_FREE=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemma-4-26b,gemma-4-31b,groq:openai/gpt-oss-20b
# Paid chain: models called with GEMINI_API_KEY_PAID (same default as free)
MODEL_CHAIN_PAID=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemma-4-26b,gemma-4-31b,groq:openai/gpt-oss-20b
# Premium thinking models (paid key, higher-quality reasoning)
MODEL_PREMIUM_THINKING=gemini-3.6-flash,gemini-3.8-flash

# ── Summary generation ───────────────────────────────────
SUMMARY_MODEL=gemini-3.6-flash
SUMMARY_FALLBACK=gemini-3.8-flash
SUMMARY_RESERVE_RPD=10

# ── Embedding model (local sentence-transformers) ────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Upload settings ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── Chunking ─────────────────────────────────────────────
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# ── Query pipeline ───────────────────────────────────────
CACHE_TTL_HOURS=24

# ── Thinking mode settings ───────────────────────────────
# Master toggle for premium/thinking features
PREMIUM_ENABLED=false
# Max thinking-mode requests per user per day
THINKING_DAILY_PER_USER=1
# Max input tokens for a thinking-mode request
THINKING_MAX_INPUT_TOKENS=8000
# Token budget allocated for model thinking/reasoning
THINKING_BUDGET_TOKENS=2000
# Max output tokens for a thinking-mode response
THINKING_MAX_OUTPUT_TOKENS=4000

# ── Cost tracking / balance guard ────────────────────────
# Max USD to spend per day on premium (thinking) requests
PREMIUM_DAILY_SPEND_CAP_USD=0.15
# Minimum account balance required to allow premium requests
PREMIUM_MIN_BALANCE_USD=2.0
# Minimum account balance required to allow paid-chain requests
PAID_MIN_BALANCE_USD=0.75
# Starting/current account balance in USD
ACCOUNT_BALANCE_USD=5.0

# ── Router & limits ──────────────────────────────────────
PROVIDER_RESET_TIMEZONE=UTC
ROUTER_QUEUE_TIMEOUT_SECONDS=60
ROUTER_COOLDOWN_429_SECONDS=60
ROUTER_COOLDOWN_5XX_SECONDS=15
ROUTER_RPD_THRESHOLD_PCT=0.95

# ── Quotas & payments ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BUDGET_GUARD_THRESHOLD=0.90
MONTHLY_SPEND_CAP_USD=0
USER_RPM_LIMIT=5
