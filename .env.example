# ── API Keys ──────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Database (direct Postgres via asyncpg) ────────────────
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Redis (Upstash URL or redis://localhost:6379) ─────────
REDIS_URL=

# ── Model chain for student answers (priority order) ─────
MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemma-4-26b,gemma-4-31b,groq:openai/gpt-oss-20b

# ── Summary generation ───────────────────────────────────
SUMMARY_MODEL=gemini-3.6-flash
SUMMARY_FALLBACK=gemini-3.8-flash
SUMMARY_RESERVE_RPD=10

# ── Embedding model (local sentence-transformers) ────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Upload settings ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── Chunking ─────────────────────────────────────────────
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
